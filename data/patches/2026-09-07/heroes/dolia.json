  "skills": [
    {
      "slot": "passive",
      "name": "Mermaid's Gift",
      "text": "Transforms into a mermaid while in water, reducing slow effects, recovering Health and Mana over time, and dealing area damage with Basic Attacks. Her Recovery skill changes to let her form a covenant with a teammate. Her Ultimate prioritizes resetting this teammate's skill cooldowns."
    },
    {
      "slot": "s1",
      "name": "Ode",
      "text": "Unleashes soundwaves that deal damage and inflict slow. When in water, the last soundwave knocks back enemies."
    },
    {
      "slot": "s2",
      "name": "Wavemaker",
      "text": "Creates a pool in the target direction, restoring Health and Mana to herself and teammates within. The pool disappears after she leaves it."
    },
    {
      "slot": "ult",
      "name": "Celestial Melody",
      "text": "Resets the longest current skill cooldown of a teammate within range, transferring the cooldown to herself. Prioritizes covenant teammates."
    }
  ],

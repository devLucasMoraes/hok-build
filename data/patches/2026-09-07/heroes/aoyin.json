    {
      "slot": "passive",
      "name": "Hidden Dragon",
      "text": "The Dragon Souls from his last 2 skill uses grant effects to his Basic Attacks, which damages one extra enemy. He gains marks when using skills, enhancing his next Basic Attack. When a target is attacked by more than 1 Dragon Soul, subsequent hits deal only 1% damage. When switching between Dragon Souls, souls of the same element are prioritized."
    },
    {
      "slot": "s1",
      "name": "Flaming Palm",
      "text": "Unleashes sword energy, dealing physical damage and true damage to enemies within range. Subsequent Basic Attacks deal extra damage."
    },
    {
      "slot": "s2",
      "name": "Downpour",
      "text": "Unleashes sword energy, dealing physical damage to enemies within range and recovering Health on hit. Subsequent Basic Attacks restore Health and Mana."
    },
    {
      "slot": "ult",
      "name": "Riding the Wind",
      "text": "Unleashes sword energy, immediately gaining Movement Speed while damaging and knocking back enemies within range. The Movement Speed increase persists after the skill ends."
    },
    {
      "slot": "ult",
      "name": "Infinite Vastness",
      "text": "Soars into the sky, then dives forward to damage and slow enemies in his path. Landing deals equal damage and applies Dread. Enhances himself, allowing his Basic Attacks to hit up to 2 more enemies."
    }
  ],

  "skills": [
    {
      "slot": "passive",
      "name": "Whirling Featherblades",
      "text": "When attacking at a distance, Basic Attacks throw a blade that returns to her. She can hit the blade as it returns to bounce it back at the enemy, dealing increased damage with each rebound. When attacking nearby targets, she enters melee mode and attacks faster. Basic Attacks mark targets. Marked enemies take extra damage from Skill 2."
    },
    {
      "slot": "s1",
      "name": "Feverish Dance",
      "text": "Sweeps the surrounding area, damaging and slowing nearby enemies. Then enters Frenzied state, gaining a major boost to Movement Speed and Attack Speed."
    },
    {
      "slot": "s2",
      "name": "Feathered Tempest",
      "text": "Dashes forward, damaging and knocking back enemies. Also triggers Featherblade marks and spreads them to nearby enemies. Then, throws rebounding blades at enemies in front, dealing damage and recovering Health. Each hit consumes 1 mark to deal extra damage."
    },
    {
      "slot": "ult",
      "name": "Final Frenzy",
      "text": "Damages nearby enemies and gains Movement Speed. Also enters the Indomitable state for 4s, gaining temporary Health. If she is defeated while this skill is not on cooldown, she resurrects after a short delay, damaging nearby enemies. The skill will then enter cooldown. Passive: Upgrading this skill increases Skill 2 and melee Basic Attack damage. The Indomitable state ends immediately if she loses all of her temporary Health."
    }
  ],

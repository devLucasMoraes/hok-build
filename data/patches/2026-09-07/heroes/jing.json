    {
      "slot": "passive",
      "name": "Lethal Reflections",
      "text": "Jing and her image apply 2 different types of marks on enemies when they deal damage. If an enemy has both types of mark at the same time, they take damage and the cooldowns of Skill 1 and Skill 2 are reset."
    },
    {
      "slot": "s1",
      "name": "Reflective Assault",
      "text": "Dashes forward, damaging enemies in her path and slowing them while enhancing her next Basic Attack. If no mirror image is present on the battlefield, one will be created to fight alongside her."
    },
    {
      "slot": "s2",
      "name": "Shattered Illusions",
      "text": "Deals damage to nearby enemies while recovering Health and gaining increased Movement Speed. If no mirror image is present on the battlefield, then one will be created to fight alongside her."
    },
    {
      "slot": "ult",
      "name": "Mirror Domain",
      "text": "Dashes forward, pulling enemies to the center of her magic circle and immobilizing them there. She gains damage reduction while inside the circle, and recovers Health when she swaps locations."
    }
  ],

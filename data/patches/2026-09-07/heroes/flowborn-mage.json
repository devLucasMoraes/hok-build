  "skills": [
    {
      "slot": "passive",
      "name": "Flow of the World",
      "text": "Can change Flow states at the Base to enhance stats. Spends 1 stack of Flow to perform an enhanced Basic Attack that deals area damage."
    },
    {
      "slot": "s1",
      "name": "Convergence",
      "text": "Channels the Flow, reducing the cooldown of other skills by 50%. Also gains 5–9 stacks of Flow based on the number of nearby heroes and minions and recovers Health based on Flow stacks. Damages and knocks back nearby enemies (without applying crowd control)."
    },
    {
      "slot": "s2",
      "name": "Flow Formation",
      "text": "Deals damage and slows enemies within range, then deals damage over time. Using the skill repeatedly within a short time enhances it, dealing damage and launching or stunning enemies. When new magic circles overlap with the initial one, they increase its damage and refresh its duration. Can spend 4 stacks of Flow to use the skill without triggering cooldown."
    },
    {
      "slot": "ult",
      "name": "Arcane Arts",
      "text": "Continuously channels a beam to deal damage over time. While the beam is linked with a hero, continuously throws Energy Bombs that deal area damage. Can spend 5 stacks of Flow to stop the skill from entering cooldown after this use."
    }
  ],

  "skills": [
    {
      "slot": "passive",
      "name": "Flow of the World",
      "text": "Can change Flow states at the Base to enhance stats. Vitality: Increases max Health and Physical and Magical Defense. Piercing Heart: Increases max Health and Physical Attack. Haste: Increases max Health and Movement Speed. Focus: Increases max Health and Cooldown Reduction. Spend 1 stack of Flow to perform an enhanced Basic Attack and deal damage and gain recovery."
    },
    {
      "slot": "s1",
      "name": "Convergence",
      "text": "Channels the Flow, reducing the cooldown of other skills by 50%. Also gains 5–9 stacks of Flow based on the number of nearby heroes and minions and recovers Health based on Flow stacks. Damages and knocks back nearby enemies (without applying crowd control)."
    },
    {
      "slot": "s2",
      "name": "Power From Within",
      "text": "Charges at the target and slashes, dealing damage, launching enemies, and gaining a shield. Using the skill continuously over a short time converts it to Clearing Slash and Rifting Slash. If the skill is not on cooldown, spend 4 stacks of Flow to stop it from entering cooldown after use."
    },
    {
      "slot": "ult",
      "name": "All In",
      "text": "Leaps to the target location and attacks, dealing damage and launching enemies. If the skill is not on cooldown, spend 5 stacks of Flow to stop it from entering cooldown after this use."
    }
  ],

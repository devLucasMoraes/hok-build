  "skills": [
    {
      "slot": "passive",
      "name": "Melodic Swing",
      "text": "Enhances her next Basic Attack periodically to swing toward the enemy, dealing damage and knocking them back, then jumping back. When any hero receives Blessing of Fate or Bitter Reconciliation, she earns Gold and reduces the preparation time of her enhanced Basic Attack."
    },
    {
      "slot": "s1",
      "name": "Heartlink",
      "text": "Blesses a teammate and restores Health. When two blessed teammates come close, they recover Health and gain Movement Speed. If she blesses an already blessed teammate, she will dash to them, and both recover Health and gain Movement Speed. Can use this skill again within 5s."
    },
    {
      "slot": "s2",
      "name": "Bitter Farewell",
      "text": "Marks an enemy, exposes them and deals continuous damage. When two marked enemies come close, they stop taking damage. If she uses the skill on a marked enemy, she will dash to them, immobilizing them and dealing continuous damage. Can use this skill again within 5s."
    },
    {
      "slot": "ult",
      "name": "Destined Encounter",
      "text": "Commands a swarm of wisps to fly forward, blessing and granting Health recovery to teammates, while marking and damaging enemies."
    }
  ],
